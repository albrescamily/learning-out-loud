---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/date";

const writing = (await getCollection("writing"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout>
  <section class="container hero">
    <div class="hero-body">
      <div class="hero-text">
        <h1 class="hero-name">Camily <span class="hero-name-last">Albres</span></h1>
        <p class="hero-role">Computer scientist - Curitiba, Brazil</p>
        <p>
          Mostly interested in distributed systems, DevOps, Machine Learning and AI
          infrastructure.
        </p>
        <p>
          This site is where I learn out loud: <a href="/writing">posts</a> when something
          deserves a proper explanation, <a href="/notes">notes</a> on whatever caught my
          attention this week, and the <a href="/projects">projects</a> I&apos;m building,
          finished or not.
        </p>
        <p><a href="/about">More about me</a></p>
      </div>
      <figure class="hero-photo">
        <img src="/cat-typing.jpeg" alt="A cat figure" width="400" height="400" />
      </figure>
    </div>
  </section>

  <div class="container">
    <div class="feed-layout">
      <section class="writing-feed">
        <SectionHeader title="Posts" />

        {writing.slice(0, 3).map(post => (
          <article class="feed-row">
            <span class="post-meta">{formatDate(post.data.published)}</span>
            <div class="feed-row-body">
              <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              {post.data.updated && (
                <span class="updated-tag">updated {formatDate(post.data.updated)}</span>
              )}
            </div>
          </article>
        ))}

        <a class="all-link" href="/writing">all writing</a>
      </section>

      <aside class="notes-rail">
        <SectionHeader title="Recent Notes" />

        <div class="note-list">
          {notes.slice(0, 5).map(item => (
            <a class="note-row" href={`/notes/${item.id}`} title={item.data.title}>
              <span class="note-date">{formatDate(item.data.published)}</span>
              <span class="note-title">{item.data.title}</span>
            </a>
          ))}
        </div>

        <a class="all-link" href="/notes">all notes</a>
      </aside>
    </div>

    <section class="projects-section">
      <SectionHeader title="Projects" />

      <div class="experiment-grid">
        {projects.slice(0, 4).map(project => <ExperimentCard project={project} />)}
      </div>

      <a class="all-link" href="/projects">all projects</a>
    </section>
  </div>
</BaseLayout>
