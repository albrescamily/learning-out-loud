---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/date";
import { projectHref } from "../lib/nav";

const writing = (await getCollection("writing"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Notes, Writing
       and code</p>
      <p class="hero-preview">
        A tiny collection of what I&apos;m learning and building.
      </p>
      <p class="hero-subtitle">
        I&apos;m Camily, a computer scientist exploring <em>distributed systems</em>,{" "}
        <em>DevOps</em>, and <em>AI infrastructure</em>.
      </p>
      <!-- temporarily removed from the hero: "about me" (/about) and
           "what I'm doing now" (/now) -->
      <!--
      <div class="hero-actions">
        <a class="hero-action" href="/about">about me</a>
        <a class="hero-action" href="/now">what I&apos;m doing now</a>
      </div>
      -->
    </div>
  </section>

  <div class="container">
    <div class="feed-layout">
      <section class="writing-feed">
        <SectionHeader title="Latest Writing" />

        {writing.slice(0, 3).map(post => (
          <article class="feed-row">
            <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="post-meta">{formatDate(post.data.published)}</div>
            {post.data.updated && (
              <span class="updated-tag">updated {formatDate(post.data.updated)}</span>
            )}
          </article>
        ))}

        <a class="all-link" href="/writing">all writing</a>
      </section>

      <aside class="notes-rail">
        <SectionHeader title="Recent Notes" />

        <div class="note-list">
          {notes.slice(0, 5).map(item => (
            <a class="note-row" href={`/notes/${item.id}`} title={item.data.title}>
              <span class="note-date">{formatDate(item.data.published)}</span>
              <span class="note-title">{item.data.title}</span>
            </a>
          ))}
        </div>

        <a class="all-link" href="/notes">all notes</a>
      </aside>
    </div>

    <section class="projects-section">
      <SectionHeader title="Projects" />

      <div class="project-list">
        {projects.slice(0, 4).map(project => (
          <article class="project-row">
            <h3><a href={projectHref(project.id)}>{project.data.title}</a></h3>
            <p class="project-row-desc">{project.data.description}</p>
            {project.data.updated && (
              <span class="updated-tag">updated {formatDate(project.data.updated)}</span>
            )}
          </article>
        ))}
      </div>

      <a class="all-link" href="/projects">all projects</a>
    </section>
  </div>
</BaseLayout>
