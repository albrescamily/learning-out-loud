---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import RandomNote from "../components/RandomNote.astro";
import PixelAquarium from "../components/PixelAquarium.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/date";

const writing = (await getCollection("writing"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-topline"><span class="lab-label">Cami's personal notebook</span></div>
      <div class="hero-heading">
        <h1 class="hero-preview">Learning out loud.<br /><span class="hero-dim">what I'm learning and building.</span></h1>
        <div class="hero-mascot"><img src="/cat-typing.jpeg" alt="A curious black cat with wide eyes" width="400" height="400" /></div>
      </div>
      <p class="hero-subtitle">
        I&apos;m Camily, a computer scientist exploring <em>distributed systems</em>,{" "}
        <em>DevOps</em>, <em>Machine Learning</em> and <em>AI infrastructure</em>.
      </p>
      <p class="hero-aside">Side projects that started with “how hard can it be?”</p>
      <div class="hero-actions">
        <RandomNote />
        <a class="hero-action" href="/about">who am I?</a>
      </div>
    </div>
  </section>

  <div class="container">
    <PixelAquarium />
    <div class="feed-layout">
      <section class="writing-feed">
        <SectionHeader title="Latest Writing" />

        {writing.slice(0, 3).map(post => (
          <article class="feed-row">
            <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="post-meta">{formatDate(post.data.published)}</div>
            {post.data.updated && (
              <span class="updated-tag">updated {formatDate(post.data.updated)}</span>
            )}
          </article>
        ))}

        <a class="all-link" href="/writing">all writing</a>
      </section>

      <aside class="notes-rail">
        <SectionHeader title="Recent Notes" />

        <div class="note-list">
          {notes.slice(0, 5).map(item => (
            <a class="note-row" href={`/notes/${item.id}`} title={item.data.title}>
              <span class="note-date">{formatDate(item.data.published)}</span>
              <span class="note-title">{item.data.title}</span>
            </a>
          ))}
        </div>

        <a class="all-link" href="/notes">all notes</a>
      </aside>
    </div>

    <section class="projects-section">
      <SectionHeader title="Projects" />

      <div class="experiment-grid">
        {projects.slice(0, 4).map(project => <ExperimentCard project={project} />)}
      </div>

      <a class="all-link" href="/projects">all projects</a>
    </section>
  </div>
</BaseLayout>
