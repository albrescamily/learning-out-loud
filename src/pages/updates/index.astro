---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActivityItem from "../../components/ActivityItem.astro";
import { getCollection } from "astro:content";
import { loadUpdates } from "../../lib/updates";

const projects = await getCollection("projects");
const titleFor = (id: string) =>
  projects.find(project => project.id === id)?.data.title ?? id;

const updates = await loadUpdates();
---
<BaseLayout title="Updates" description="Short updates from across every project.">
  <div class="container archive-page">
    <div class="eyebrow">updates</div>
    <h1>Short updates from active projects.</h1>

    <div class="update-list">
      {updates.map(update => (
        <ActivityItem
          date={update.entry.data.published}
          label={titleFor(update.projectId)}
          href={update.href}
          title={update.entry.data.title}
        />
      ))}
    </div>
  </div>
</BaseLayout>
