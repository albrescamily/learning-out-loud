---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListingEntry from "../../components/ListingEntry.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("notes"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Notes">
  <div class="listing-page">
    <h1 class="listing-title">Notes</h1>
    <p class="listing-description">random notes I want to share</p>

    <div class="listing-content">
      {items.length === 0 ? (
        <p class="listing-empty">No notes published yet.</p>
      ) : (
        <ul class="listing-items">
          {items.map(item => (
            <ListingEntry
              href={`/notes/${item.id}`}
              title={item.data.title}
              dateLabel="Published"
              date={item.data.published}
              dateBesideTitle
            />
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
