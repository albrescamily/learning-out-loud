---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListingEntry from "../../components/ListingEntry.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Writing">
  <div class="listing-page">
    <h1 class="listing-title">Writing</h1>
    <p class="listing-description">the stuff I actually bothered to edit</p>

    <div class="listing-content">
      {posts.length === 0 ? (
        <p class="listing-empty">No essays published yet.</p>
      ) : (
        <ul class="listing-items">
          {posts.map(post => (
            <ListingEntry
              href={`/writing/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              dateLabel="Published"
              date={post.data.published}
            />
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
