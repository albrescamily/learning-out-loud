---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExperimentCard from "../../components/ExperimentCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Projects">
  <div class="listing-page">
    <h1 class="listing-title">Projects</h1>
    <p class="listing-description">These are my working notes.</p>

    <div class="listing-content">
      {projects.length === 0 ? (
        <p class="listing-empty">No projects published yet.</p>
      ) : (
        <ul class="experiment-grid experiment-list">
          {projects.map(project => (
            <li><ExperimentCard project={project} heading="h2" /></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
