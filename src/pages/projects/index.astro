---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { projectHref } from "../../lib/nav";
import { formatDate } from "../../lib/date";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Projects">
  <div class="container archive-page">
    <div class="eyebrow">projects</div>
    <h3 class="page-legend">personal, raw notes about projects</h3>
    <div class="project-list archive-projects">
      {projects.map(project => (
        <article class="project-row">
          <h3><a href={projectHref(project.id)}>{project.data.title}</a></h3>
          <p class="project-row-desc">{project.data.description}</p>
          <span class="updated-tag">updated {formatDate(project.data.updated ?? project.data.published)}</span>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
