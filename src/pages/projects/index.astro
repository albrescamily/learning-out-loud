---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListingEntry from "../../components/ListingEntry.astro";
import { getCollection } from "astro:content";
import { projectHref } from "../../lib/nav";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Projects">
  <div class="listing-page">
    <h1 class="listing-title">Projects</h1>
    <p class="listing-description">personal, raw notes about projects</p>

    <div class="listing-content">
      {projects.length === 0 ? (
        <p class="listing-empty">No projects published yet.</p>
      ) : (
        <ul class="listing-items">
          {projects.map(project => (
            <ListingEntry
              href={projectHref(project.id)}
              title={project.data.title}
              description={project.data.description}
              dateLabel="Updated"
              date={project.data.updated ?? project.data.published}
            />
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
