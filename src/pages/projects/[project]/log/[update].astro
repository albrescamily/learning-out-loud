---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import Pager from "../../../../components/Pager.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../../../../lib/date";
import { logHref, neighbours, projectHref } from "../../../../lib/nav";
import { updatesByProject } from "../../../../lib/updates";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const grouped = await updatesByProject();

  return projects.flatMap(project => {
    const updates = grouped.get(project.id) ?? [];

    const link = (item: (typeof updates)[number]) => ({
      href: item.href,
      title: item.entry.data.title
    });

    // Neighbours stay inside the project, so paging never jumps to a log the
    // reader is not in.
    return updates.map((update, i) => {
      const { newer, older } = neighbours(updates, i);
      return {
        params: { project: project.id, update: update.entry.id },
        props: {
          project,
          update,
          total: updates.length,
          newer: newer && link(newer),
          older: older && link(older)
        }
      };
    });
  });
}

const { project, update, total, newer, older } = Astro.props;
const { Content } = await render(update.entry);

const trail = [
  { href: "/projects", label: "projects" },
  { href: projectHref(project.id), label: project.data.title },
  { href: logHref(project.id), label: "log" }
];
---
<BaseLayout title={update.entry.data.title} description={`An update from ${project.data.title}.`}>
  <article class="container article-page">
    <Breadcrumb trail={trail} title={update.entry.data.title} />
    <div class="post-meta">
      <a class="meta-link" href={projectHref(project.id)}>{project.data.title}</a>
      {" · "}{formatDate(update.entry.data.published)}
    </div>
    <h1>{update.entry.data.title}</h1>

    <div class="micro-label log-backlink">
      <a href={`${logHref(project.id)}#update-${update.number}`}
        >update {update.number} of {total} in the project log →</a>
    </div>

    <div class="prose"><Content /></div>

    <Pager
      newer={newer}
      older={older}
      index={{ href: logHref(project.id), title: `all ${project.data.title} updates` }}
    />
  </article>
</BaseLayout>
