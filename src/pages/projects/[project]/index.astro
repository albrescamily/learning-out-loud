---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Pager from "../../../components/Pager.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { project: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="container article-page project-page" data-status={project.data.status}>
    <Breadcrumb title={project.data.title} />
    <div class="post-meta">
      <span class="project-status">{project.data.status}</span>
      {" · "}{project.data.stack.join(" · ")}
    </div>
    <h1>{project.data.title}</h1>
    <p class="article-lead">{project.data.description}</p>

    <div class="prose"><Content /></div>

    <Pager index={{ href: "/projects", title: "all projects" }} />
  </article>
</BaseLayout>
