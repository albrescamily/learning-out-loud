---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Pager from "../../../components/Pager.astro";
import { statusLabels } from "../../../lib/lab";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map(project => ({
    params: { project: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status } = project.data;
const stack = project.data.stack.filter(Boolean);
---
<BaseLayout title={title}>
  <article class="container article-page project-page">
    <Breadcrumb title={title} />
    <header class="project-header">
      <div class="project-meta">
        <span class="project-status">{statusLabels[status]}</span>
      </div>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      {stack.length > 0 && (
        <ul class="experiment-stack" aria-label="Technology stack">
          {stack.map(item => <li>{item}</li>)}
        </ul>
      )}
    </header>

    <div class="prose"><Content /></div>

    <Pager index={{ href: "/projects", title: "all projects" }} />
  </article>
</BaseLayout>
