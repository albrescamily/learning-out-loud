---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About">
  <div class="container article-page">
    <div class="eyebrow">about</div>
    <h1>Backend engineer interested in systems and tooling.</h1>
    <div class="prose">
      <p>
        This site is my public engineering notebook. I use it to document projects,
        decisions, mistakes, experiments and things worth remembering.
      </p>

      <h2>Working principles</h2>
      <ul>
        <li>Measure before optimizing.</li>
        <li>Prefer boring infrastructure.</li>
        <li>Make failure visible.</li>
        <li>Write down why.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
