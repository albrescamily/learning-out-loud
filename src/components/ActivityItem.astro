---
import { formatDate } from "../lib/date";

interface Props {
  date: Date;
  /** Small uppercase kicker: the project name in the feed, "update 2" in a log. */
  label?: string;
  href?: string;
  title: string;
}

const { date, label, href = "#", title } = Astro.props;

const formatted = formatDate(date);
---
<article class="activity-item">
  <div class="activity-meta">{formatted}</div>
  {label && <div class="activity-label">{label}</div>}
  <a class="activity-title" href={href}>{title}</a>
</article>
