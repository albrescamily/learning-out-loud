---
import { nav, isActive } from "../lib/nav";
// Self-hosted Geist Mono, one stylesheet per weight actually used on the
// site — see the "Allowed font weights" rule in the typography system.
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "camily albres." } = Astro.props;

// One description for the whole site, so every shared link reads the same.
const description = "Camily Albres — notes, writing and code.";

const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint: resolves the theme so the page never flashes
      // the wrong palette. The `js` class reveals the controls that are useless
      // without scripting — the theme toggle and the mobile menu button.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var stored = null;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        root.dataset.theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>camily albres.</a>
        <div class="header-right">
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >menu</button>
          <nav id="site-nav" class="site-nav" aria-label="Main navigation">
            {nav.map(item => (
              <a
                href={item.href}
                aria-current={isActive(path, item.href) ? "page" : undefined}
              >{item.label}</a>
            ))}
          </nav>
          <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme">
            <span data-when="light">dark</span>
            <span data-when="dark">light</span>
          </button>
        </div>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <nav class="footer-social" aria-label="Elsewhere">
          <a href="https://github.com/albrescamily" rel="me noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.26 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/camily-albres" rel="me noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          </a>
        </nav>
        <span class="footer-copyright">
          <span>camilyalbres 2026</span>
          <span class="footer-place">Curitiba, Brazil</span>
        </span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector(".theme-toggle").addEventListener("click", function () {
        var root = document.documentElement;
        var next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });

      // Mobile menu. The open state lives in a data attribute on the header so
      // the desktop media query always wins — using `hidden` would leave the
      // nav stuck closed after resizing back up.
      (function () {
        var header = document.querySelector(".site-header");
        var toggle = header.querySelector(".nav-toggle");

        function setOpen(open) {
          if (open) header.dataset.navOpen = "";
          else delete header.dataset.navOpen;
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }

        toggle.addEventListener("click", function () {
          setOpen(!("navOpen" in header.dataset));
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && "navOpen" in header.dataset) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();
    </script>
  </body>
</html>
