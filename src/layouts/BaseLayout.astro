---
import { nav, isActive } from "../lib/nav";
import SocialLinks from "../components/SocialLinks.astro";
// Self-hosted fonts, one stylesheet per weight actually used on the site —
// see the "Allowed font weights" rule in the typography system. Montserrat
// sets everything, italic included for `em`; Geist Mono is only for code
// (700 for code in table headers).
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/500-italic.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "camily albres." } = Astro.props;

// One description for the whole site, so every shared link reads the same.
const description = "Camily Albres — notes, writing and code.";

const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint. The `js` class reveals the mobile menu button,
      // which is useless without scripting.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>learning out loud</a>
        <div class="header-right">
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >menu</button>
          <nav id="site-nav" class="site-nav" aria-label="Main navigation">
            {nav.map(item => (
              <a
                href={item.href}
                aria-current={isActive(path, item.href) ? "page" : undefined}
              >{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
      <div class="container scroll-progress" aria-hidden="true"></div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <nav class="footer-social" aria-label="Elsewhere">
          <SocialLinks />
        </nav>
        <span class="footer-copyright">
          <span>camilyalbres 2026</span>
          <span class="footer-place">Curitiba, Brazil</span>
        </span>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Image viewer">
      <button class="lightbox-close" type="button">close</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>

    <script is:inline>
      // Reading progress: the orange bar on the header line fills as the page
      // scrolls. Without scripting it stays at zero, so it never shows.
      (function () {
        var bar = document.querySelector(".scroll-progress");
        function update() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? Math.min(window.scrollY / max, 1) : 0) + ")";
        }
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      })();

      // Lightbox: a figure's image, a project's cover thumbnail, or a book
      // cover on the about page opens full size in a modal dialog. The dialog
      // gives Esc-to-close and focus handling for free; a click anywhere
      // closes it too. Images that are already links are left alone.
      (function () {
        var dialog = document.querySelector(".lightbox");
        var full = dialog.querySelector("img");
        var caption = dialog.querySelector("figcaption");
        var root = document.documentElement;

        // The largest file in the srcset Astro wrote, not the one sized for
        // the column.
        function largest(img) {
          var best = img.currentSrc || img.src, bestW = 0;
          (img.getAttribute("srcset") || "").split(",").forEach(function (c) {
            var parts = c.trim().split(/\s+/), w = parseInt(parts[1], 10);
            if (parts[0] && w > bestW) { best = parts[0]; bestW = w; }
          });
          return best;
        }

        // The caption is the image's own data-caption, a figcaption, or the
        // Obsidian `<center>` line right after the figure.
        function captionOf(img) {
          if (img.dataset.caption) return img.dataset.caption;
          var figure = img.closest("figure");
          if (!figure) return "";
          var own = figure.querySelector("figcaption");
          if (own) return own.textContent;
          var next = figure.nextElementSibling;
          return next && next.tagName === "CENTER" ? next.textContent : "";
        }

        function open(img) {
          full.src = largest(img);
          full.alt = img.alt;
          caption.textContent = captionOf(img);
          caption.hidden = !caption.textContent;
          root.classList.add("lightbox-open");
          dialog.showModal();
        }

        dialog.addEventListener("click", function () { dialog.close(); });
        dialog.addEventListener("close", function () {
          root.classList.remove("lightbox-open");
          full.removeAttribute("src");
        });

        document.querySelectorAll(".prose figure > img, .experiment-cover, img.book-cover").forEach(function (img) {
          img.classList.add("zoomable");
          img.tabIndex = 0;
          img.setAttribute("role", "button");
          img.setAttribute("aria-label", "Open image" + (img.alt ? ": " + img.alt : ""));
          img.addEventListener("click", function (e) { e.preventDefault(); open(img); });
          img.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(img); }
          });
        });
      })();

      // Copy code: a code block gets a Copy button in its corner, and inline
      // code copies itself on click. Both flash "Copied" for a moment.
      (function () {
        if (!navigator.clipboard) return;

        function copy(text, el) {
          navigator.clipboard.writeText(text).then(function () {
            el.classList.add("copied");
            clearTimeout(el._copyTimer);
            el._copyTimer = setTimeout(function () { el.classList.remove("copied"); }, 1500);
          });
        }

        document.querySelectorAll(".prose pre").forEach(function (pre) {
          var wrap = document.createElement("div");
          wrap.className = "code-block";
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);

          var button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy";
          button.setAttribute("aria-label", "Copy code");
          button.innerHTML =
            '<svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>' +
            '<svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>';
          wrap.appendChild(button);
          button.addEventListener("click", function () {
            copy(pre.textContent.replace(/\n$/, ""), button);
          });
        });

        document.querySelectorAll(".prose :not(pre) > code").forEach(function (code) {
          if (code.closest("a")) return;
          code.classList.add("copyable");
          code.tabIndex = 0;
          code.setAttribute("role", "button");
          code.setAttribute("aria-label", "Copy: " + code.textContent);
          code.addEventListener("click", function () { copy(code.textContent, code); });
          code.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); copy(code.textContent, code); }
          });
        });
      })();

      // Mobile menu. The open state lives in a data attribute on the header so
      // the desktop media query always wins — using `hidden` would leave the
      // nav stuck closed after resizing back up.
      (function () {
        var header = document.querySelector(".site-header");
        var toggle = header.querySelector(".nav-toggle");

        function setOpen(open) {
          if (open) header.dataset.navOpen = "";
          else delete header.dataset.navOpen;
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }

        toggle.addEventListener("click", function () {
          setOpen(!("navOpen" in header.dataset));
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && "navOpen" in header.dataset) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();
    </script>
  </body>
</html>
