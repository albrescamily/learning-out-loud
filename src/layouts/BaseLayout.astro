---
import { nav, isActive } from "../lib/nav";
// Self-hosted fonts, one stylesheet per weight actually used on the site —
// see the "Allowed font weights" rule in the typography system. Geist Mono
// sets everything; Montserrat is only for reading text (paragraphs and lists
// in the prose), at its body weight and the bold of `strong`.
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "camily albres." } = Astro.props;

// One description for the whole site, so every shared link reads the same.
const description = "Camily Albres — notes, writing and code.";

const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint. The `js` class reveals the mobile menu button,
      // which is useless without scripting.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>camily albres.</a>
        <div class="header-right">
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >menu</button>
          <nav id="site-nav" class="site-nav" aria-label="Main navigation">
            {nav.map(item => (
              <a
                href={item.href}
                aria-current={isActive(path, item.href) ? "page" : undefined}
              >{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
      <div class="container scroll-progress" aria-hidden="true"></div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <nav class="footer-social" aria-label="Elsewhere">
          <a href="https://github.com/albrescamily" rel="me noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.26 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/camily-albres" rel="me noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          </a>
        </nav>
        <span class="footer-copyright">
          <span>camilyalbres 2026</span>
          <span class="footer-place">Curitiba, Brazil</span>
        </span>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Image viewer">
      <button class="lightbox-close" type="button">close</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>

    <script is:inline>
      // Reading progress: the orange bar on the header line fills as the page
      // scrolls. Without scripting it stays at zero, so it never shows.
      (function () {
        var bar = document.querySelector(".scroll-progress");
        function update() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? Math.min(window.scrollY / max, 1) : 0) + ")";
        }
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      })();

      // Lightbox: a figure's image opens full size in a modal dialog. The
      // dialog gives Esc-to-close and focus handling for free; a click
      // anywhere closes it too. Images that are already links are left alone.
      (function () {
        var dialog = document.querySelector(".lightbox");
        var full = dialog.querySelector("img");
        var caption = dialog.querySelector("figcaption");
        var root = document.documentElement;

        // The largest file in the srcset Astro wrote, not the one sized for
        // the column.
        function largest(img) {
          var best = img.currentSrc || img.src, bestW = 0;
          (img.getAttribute("srcset") || "").split(",").forEach(function (c) {
            var parts = c.trim().split(/\s+/), w = parseInt(parts[1], 10);
            if (parts[0] && w > bestW) { best = parts[0]; bestW = w; }
          });
          return best;
        }

        // The caption is a figcaption, or the Obsidian `<center>` line right
        // after the figure.
        function captionOf(figure) {
          var own = figure.querySelector("figcaption");
          if (own) return own.textContent;
          var next = figure.nextElementSibling;
          return next && next.tagName === "CENTER" ? next.textContent : "";
        }

        function open(img) {
          full.src = largest(img);
          full.alt = img.alt;
          caption.textContent = captionOf(img.closest("figure"));
          caption.hidden = !caption.textContent;
          root.classList.add("lightbox-open");
          dialog.showModal();
        }

        dialog.addEventListener("click", function () { dialog.close(); });
        dialog.addEventListener("close", function () {
          root.classList.remove("lightbox-open");
          full.removeAttribute("src");
        });

        document.querySelectorAll(".prose figure > img").forEach(function (img) {
          img.classList.add("zoomable");
          img.tabIndex = 0;
          img.setAttribute("role", "button");
          img.setAttribute("aria-label", "Open image" + (img.alt ? ": " + img.alt : ""));
          img.addEventListener("click", function () { open(img); });
          img.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(img); }
          });
        });
      })();

      // Mobile menu. The open state lives in a data attribute on the header so
      // the desktop media query always wins — using `hidden` would leave the
      // nav stuck closed after resizing back up.
      (function () {
        var header = document.querySelector(".site-header");
        var toggle = header.querySelector(".nav-toggle");

        function setOpen(open) {
          if (open) header.dataset.navOpen = "";
          else delete header.dataset.navOpen;
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }

        toggle.addEventListener("click", function () {
          setOpen(!("navOpen" in header.dataset));
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && "navOpen" in header.dataset) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();
    </script>
  </body>
</html>
